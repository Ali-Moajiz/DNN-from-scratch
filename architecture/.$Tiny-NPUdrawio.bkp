        <object label="Bias-load / acc&lt;br&gt;32-bit register" tooltip="Earlier feedback example. Active array cell psum registers capture incoming neighbour psum + signed product; column 1 uses the row bias. See the array and proposed schedule on page 06." id="fEt4LbSzs0sntKll7tNw-118">
          <mxCell parent="1" style="whiteSpace=wrap;html=1;" vertex="1">
