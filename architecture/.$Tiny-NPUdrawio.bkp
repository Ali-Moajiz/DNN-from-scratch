        <object label="Accumulate K products&lt;br&gt;on enabled clock edges" tooltip="Earlier serial feedback MAC only. In the active array, accumulation occurs across 4 columns; one product per cell per vector, with direct registered neighbour connections." id="fEt4LbSzs0sntKll7tNw-123">
          <mxCell parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" vertex="1">
            <mxGeometry height="55" width="240" x="420" y="465" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="fEt4LbSzs0sntKll7tNw-124" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Final registered sum&lt;br&gt;after K updates" vertex="1">
          <mxGeometry height="55" width="250" x="1340" y="265" as="geometry" />
        </mxCell>
        <object label="&lt;font style=&quot;font-size: 15px;&quot;&gt;Feedback MAC (earlier reference)&lt;/font&gt;" tooltip="Upper feedback example is historical. The active array below passes partial sums right and x down. No self-feedback loop is used for a single vector in this array schedule." id="fEt4LbSzs0sntKll7tNw-125">
          <mxCell parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" vertex="1">
            <mxGeometry height="40" width="300" x="670" y="185" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="fEt4LbSzs0sntKll7tNw-126" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 16px;&quot;&gt;NPU Architecture&lt;/font&gt;" vertex="1">
          <mxGeometry height="40" width="280" x="130" y="610" as="geometry" />
        </mxCell>
        <object label="Tile sequencer / AGU&lt;br&gt;address + capture control&lt;br&gt;FSM / counters" tooltip="Baseline controller is a hardware FSM with address registers, an incrementer/stride logic, destination tags and latency-matched capture strobes. CPU submits base addresses and START; data does not pass through CPU scalar registers. Issue W, BIAS, CFG, X reads consecutively; delay destination/valid tags to match SRAM read latency. CAP_W loads all PE weight registers directly; CAP_B/CFG/X load local registers. Start C1 only after all operands/config are valid. Count C1..C7, enable POST only when row 4 is complete and FIFO is empty; STORE writes SRAM with byte enables, then DONE. One 128-bit single read/write port; read and write operations are serialized. No AXI arbitration between this local SRAM and the array." id="fEt4LbSzs0sntKll7tNw-127">
          <mxCell parent="1" style="whiteSpace=wrap;html=1;" vertex="1">
            <mxGeometry height="240" width="200" x="100" y="980" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="fEt4LbSzs0sntKll7tNw-128" edge="1" parent="1" source="fEt4LbSzs0sntKll7tNw-129" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=page;edgeStyle=none;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" target="fEt4LbSzs0sntKll7tNw-137" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points" />
          </mxGeometry>
        </mxCell>
        <object label="4 x 4 MAC array&lt;br&gt;16 x INT8 MACs&lt;br&gt;registered psum32&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;W registers load in parallel&lt;br&gt;x down / psum right&lt;/font&gt;" tooltip="Retains this drawing’s weight-stationary wavefront, not a copy of Coral’s outer-product/VME engine. 128 SRAM data bits fan out directly to 16 stationary 8-bit PE weight registers under CAP_W. No separate weight-copy stage. Each cell also has registered x and INT32 psum; old neighbour values are used at each edge. One-based MAC(r,c) fires at C(r+c-1), rows complete C4..C7, and final row sums hold until POST. Column 1 starts from the matching INT32 bias. Compiler/exporter supplies row-major weight order; larger/masked tiles are future work." id="fEt4LbSzs0sntKll7tNw-129">
          <mxCell parent="1" style="whiteSpace=wrap;html=1;" vertex="1">
            <mxGeometry height="460" width="220" x="1150" y="880" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="fEt4LbSzs0sntKll7tNw-132" edge="1" parent="1" source="fEt4LbSzs0sntKll7tNw-157" style="rounded=0;html=1;endArrow=classic;edgeStyle=none;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.6428571428571429;entryX=0;entryY=0.7391;exitPerimeter=0;entryPerimeter=0;" target="fEt4LbSzs0sntKll7tNw-129" value="x[31:0]">
          <mxGeometry relative="1" as="geometry">
            <Array as="points" />
          </mxGeometry>
        </mxCell>
        <object label="" tooltip="Direct 128-bit SRAM Q fanout into PE weight registers, gated by the sequencer’s delayed CAP_W. It is the same SRAM output as the operand-register branch; these are not two read ports." id="fEt4LbSzs0sntKll7tNw-133">
          <mxCell edge="1" parent="1" source="fEt4LbSzs0sntKll7tNw-150" style="rounded=0;html=1;endArrow=classic;edgeStyle=none;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=0;entryX=0;entryY=0.26;exitPerimeter=0;entryPerimeter=0;" target="fEt4LbSzs0sntKll7tNw-129">
            <mxGeometry relative="1" as="geometry">
              <Array as="points">
                <mxPoint x="1100" y="1530" />
                <mxPoint x="1040" y="1530" />
                <mxPoint x="1040" y="1000" />
              </Array>
            </mxGeometry>
          </mxCell>
        </object>
        <object label="Skew: C1–C4&lt;br&gt;4 x INT8" tooltip="Local x register drives array top-row skew mux: x_c enters at compute cycle Cc. Downstream rows read registered x from the preceding row. No SRAM accesses are required during the 7 compute cycles." id="fEt4LbSzs0sntKll7tNw-134">
          <mxCell parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" vertex="1">
            <mxGeometry height="45" width="140" x="860" y="1100" as="geometry" />
          </mxCell>
        </object>
        <object label="W[127:0]&lt;br&gt;direct to PE registers" tooltip="All 16 INT8 weights in one aligned 128-bit line. PE[r][c].W captures rdata[8*(4*r+c)+:8] on CAP_W using zero-based r,c. This is fixed parallel wiring, not 16 addressed register writes." id="fEt4LbSzs0sntKll7tNw-135">
          <mxCell parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" vertex="1">
            <mxGeometry height="45" width="150" x="910" y="1350" as="geometry" />
          </mxCell>
        </object>
        <object label="ADDR / RD / WR / BE" tooltip="Native single-port SRAM control: logical addr[31:0] is a BYTE address, 16-byte aligned for wide accesses. SRAM line address is addr[13:4] for 1024x128 storage. RD_EN and WR_EN are mutually exclusive; WBE[15:0] enables byte writes. One read/write operation per edge. No AXI channel framing/IDs/arbitration is required inside this dedicated path." id="fEt4LbSzs0sntKll7tNw-136">
          <mxCell edge="1" parent="1" source="fEt4LbSzs0sntKll7tNw-127" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=page;edgeStyle=none;jumpStyle=arc;jumpSize=10;exitX=0.35;exitY=1;entryX=0;entryY=0.3076923076923077;exitPerimeter=0;entryPerimeter=0;" target="fEt4LbSzs0sntKll7tNw-150">
            <mxGeometry relative="1" x="-1" as="geometry">
              <mxPoint x="130" y="375" as="offset" />
              <Array as="points">
                <mxPoint x="170" y="1620" />
              </Array>
            </mxGeometry>
          </mxCell>
        </object>
        <object label="Activation x4&lt;br&gt;ReLU / bypass&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;4 x signed INT32&lt;/font&gt;" tooltip="One unit per completed row. ReLU computes max(0,psum), or bypasses for output logits. Configuration comes from the local CFG registers. POST captures only after all row outputs are valid." id="fEt4LbSzs0sntKll7tNw-137">
          <mxCell parent="1" style="whiteSpace=wrap;html=1;" vertex="1">
            <mxGeometry height="460" width="200" x="1500" y="880" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="fEt4LbSzs0sntKll7tNw-139" edge="1" parent="1" source="fEt4LbSzs0sntKll7tNw-127" style="endArrow=classic;html=1;rounded=0;defaultLabelBackgroundColor=page;edgeStyle=none;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.625;entryX=0.5;entryY=1;exitPerimeter=0;entryDx=0;entryDy=0;" target="fEt4LbSzs0sntKll7tNw-129" value="">
          <mxGeometry relative="1" x="0.0144" as="geometry">
            <Array as="points">
              <mxPoint x="480" y="1130" />
              <mxPoint x="480" y="1450" />
              <mxPoint x="1260" y="1450" />
            </Array>
          </mxGeometry>
        </mxCell>
        <object label="CAP_W / C1–C7" tooltip="CAP_W captures all stationary weights in parallel. Compute control enables only the diagonal r+c-1 for each C step. LOAD and COMPUTE are distinct phases. Tile start clears validity; row sums are held until POST." id="fEt4LbSzs0sntKll7tNw-141">
          <mxCell parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" vertex="1">
            <mxGeometry height="30" width="150" x="1030" y="1460" as="geometry" />
          </mxCell>
        </object>
        <object label="" tooltip="SRAM wrapper returns RD_VALID after the configured read latency. This is a delayed read-enable indication, not an SRAM-initiated transaction. Sequencer aligns the destination tag/capture strobe with valid data. If a selected implementation can stall, ready/valid or a response queue must be added; the page-06 timing assumes no stalls." id="fEt4LbSzs0sntKll7tNw-142">
          <mxCell edge="1" parent="1" source="fEt4LbSzs0sntKll7tNw-150" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=page;edgeStyle=none;jumpStyle=arc;jumpSize=10;exitX=0;exitY=0.6923076923076923;exitPerimeter=0;entryX=0.073;entryY=1.007;entryDx=0;entryDy=0;entryPerimeter=0;" target="fEt4LbSzs0sntKll7tNw-127">
            <mxGeometry relative="1" x="-0.2917" y="40" as="geometry">
              <mxPoint as="offset" />
              <Array as="points">
                <mxPoint x="110" y="1670" />
              </Array>
              <mxPoint x="160" y="1230" as="targetPoint" />
            </mxGeometry>
          </mxCell>
        </object>
        <object label="Result FIFO / hold&lt;br&gt;1 entry = 4 x INT8&lt;br&gt;POST push / STORE pop" tooltip="Capture four final q bytes at POST only if empty. Retain the packed 32-bit word until STORE writes it into the low four byte lanes of a 128-bit SRAM line. valid clears only when the write is accepted. Single-port write arbitration belongs to the sequencer. Additional FIFO depth is optional, not required for this non-overlapped baseline." id="fEt4LbSzs0sntKll7tNw-143">
          <mxCell parent="1" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1">
            <mxGeometry height="460" width="200" x="2200" y="880" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="fEt4LbSzs0sntKll7tNw-144" edge="1" parent="1" source="fEt4LbSzs0sntKll7tNw-158" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=page;edgeStyle=none;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" target="fEt4LbSzs0sntKll7tNw-143">
          <mxGeometry relative="1" x="0.2627" as="geometry">
            <Array as="points" />
          </mxGeometry>
        </mxCell>
        <mxCell id="fEt4LbSzs0sntKll7tNw-146" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="4 x 32-bit" vertex="1">
          <mxGeometry height="30" width="110" x="1385" y="1075" as="geometry" />
        </mxCell>
        <mxCell id="fEt4LbSzs0sntKll7tNw-148" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="4 x 8-bit" vertex="1">
          <mxGeometry height="30" width="90" x="2060" y="1075" as="geometry" />
        </mxCell>
        <object label="Local SRAM: 1024 x 128-bit, single read/write port&lt;br&gt;16 KiB; native address / enables / 16 byte-write enables&lt;br&gt;Direct Q wiring to PE weights and operand/config registers" tooltip="Proposed 128-bit local memory, not the old 32-bit C memory interface. One wide macro or four lockstep 32-bit banks may implement the logical port. Byte addresses; 16-byte-aligned lines. A=0x0000, W1=0x0100, W2=0x0110, B1=0x0200, B2=0x0210, hidden B=0x0300, CFG1=0x0400, CFG2=0x0410. All 16 weights occupy one line, four INT32 biases one line, M/S/flags/reserved one line, and each input/output vector uses low32 of one line. Writes need per-byte enables; otherwise a read-modify-write wrapper changes the schedule. 256-bit option requires wider storage/banking, routing and a redesigned packed layout; changing wire width alone is insufficient. Host preloads while idle; concurrent host/compute access would need arbitration or another port." id="fEt4LbSzs0sntKll7tNw-150">
          <mxCell parent="1" style="whiteSpace=wrap;html=1;" vertex="1">
            <mxGeometry height="130" width="900" x="650" y="1580" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="fEt4LbSzs0sntKll7tNw-151" edge="1" parent="1" source="fEt4LbSzs0sntKll7tNw-143" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=page;edgeStyle=none;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=1;entryX=1;entryY=0.38461538461538464;exitPerimeter=0;entryPerimeter=0;" target="fEt4LbSzs0sntKll7tNw-150">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="2300" y="1630" />
            </Array>
          </mxGeometry>
        </mxCell>
        <object label="wdata[127:0]&lt;br&gt;q[31:0], BE=0x000F" tooltip="FIFO q word drives SRAM WDATA[31:0]; upper96 may be zero. Byte-write-enable bits[3:0]=1 update exactly the output vector; bits[15:4]=0 preserve the rest. WR_EN and aligned destination address come from sequencer. No read-modify-write is assumed because byte-write enables are available." id="fEt4LbSzs0sntKll7tNw-152">
          <mxCell parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" vertex="1">
            <mxGeometry height="45" width="205" x="1690" y="1580" as="geometry" />
          </mxCell>
        </object>
        <object label="L1: A → hidden B&lt;br&gt;L2: B → A&lt;br&gt;after STORE completes" tooltip="Baseline retains SRAM layer handoff for simplicity: STORE L1 hidden word, then read that word for L2. Input/output vector uses the low32 of a 128-bit line. A direct hidden-register bypass and persistent two-layer weight banks are later optimizations, not part of the page-06 28-edge proposal." id="fEt4LbSzs0sntKll7tNw-153">
          <mxCell parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" vertex="1">
            <mxGeometry height="70" width="270" x="2430" y="1080" as="geometry" />
          </mxCell>
        </object>
        <object label="128-bit baseline; 256-bit is an optional future variant.&lt;br&gt;Proposed timing on page 06; existing C model remains 66 cycles." tooltip="Hardware proposal only. Under one-cycle SRAM response, consecutive requests, no stalls, and one-stage POST: cold tile uses 5 setup edges + 7 compute + POST + STORE=14; two layers=28. Not a measured/synthesized result. CPU command issue/model preload are excluded. Extra memory/compute/requantizer pipeline stages change timing." id="fEt4LbSzs0sntKll7tNw-154">
          <mxCell parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" vertex="1">
            <mxGeometry height="45" width="550" x="830" y="1730" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="fEt4LbSzs0sntKll7tNw-155" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;dashed=1;" value="" vertex="1">
          <mxGeometry height="550" width="320" x="1090" y="832.5" as="geometry" />
        </mxCell>
        <mxCell id="fEt4LbSzs0sntKll7tNw-156" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="4 x 4 MAC array" vertex="1">
          <mxGeometry height="30" width="160" x="1160" y="800" as="geometry" />
        </mxCell>
        <object label="Operand capture / routing&lt;br&gt;fixed lanes + enables&lt;br&gt;x32 | bias128 | cfg96" tooltip="This replaces the generic fetch/copy FSM. The block represents local x, bias, and M/S/ReLU registers plus fixed capture wiring. No independent SRAM requests originate here. One shared rdata[127:0] fans out to destinations; delayed destination tag selectively enables capture. On CAP_X, bits31:0 latch x1..x4; on CAP_BIAS, 4x32-bit fields latch; on CAP_CFG, M32/S32/flags32 latch and upper32 is reserved. W bypasses this block and captures directly into the array PE W registers. Skew injection uses x_word in the array. An implementation can place these registers physically beside the consumers; this is not an extra pipeline copy." id="fEt4LbSzs0sntKll7tNw-157">
          <mxCell parent="1" style="whiteSpace=wrap;html=1;" vertex="1">
            <mxGeometry height="140" width="220" x="650" y="1130" as="geometry" />
          </mxCell>
        </object>
        <object label="Requantize / clamp x4&lt;br&gt;INT32 x M → INT64&lt;br&gt;round / shift S → INT8" tooltip="q=clamp_INT8(round_nearest_ties_even(activated*M/2^S)), with positive INT32 M and S=0..62. This matches the updated Python numerical contract. INT32 biases use input_scale*weight_scale units. No MAC saturation; reject/avoid INT32 overflow. Page-06 POST assumes this path meets timing in one stage; real synthesis may require added pipeline stages and a revised latency." id="fEt4LbSzs0sntKll7tNw-158">
          <mxCell parent="1" style="whiteSpace=wrap;html=1;" vertex="1">
            <mxGeometry height="460" width="200" x="1850" y="880" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="fEt4LbSzs0sntKll7tNw-159" edge="1" parent="1" source="fEt4LbSzs0sntKll7tNw-137" style="rounded=0;html=1;endArrow=classic;defaultLabelBackgroundColor=page;edgeStyle=none;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" target="fEt4LbSzs0sntKll7tNw-158" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points" />
          </mxGeometry>
        </mxCell>
        <object label="rdata[127:0]" tooltip="Native SRAM read data, shared with the direct PE-weight path. Logical 128-bit port may be one wide macro or four 32-bit banks addressed in lockstep. A read response appears after the specified SRAM latency. Capture tags/enables, generated externally, decide which destination registers latch it. SRAM never starts a transfer on its own." id="fEt4LbSzs0sntKll7tNw-162">
          <mxCell edge="1" parent="1" source="fEt4LbSzs0sntKll7tNw-150" style="rounded=0;html=1;endArrow=classic;defaultLabelBackgroundColor=page;edgeStyle=none;jumpStyle=arc;jumpSize=10;exitX=0.3333333333333333;exitY=0;entryX=0.5;entryY=1;exitPerimeter=0;entryPerimeter=0;" target="fEt4LbSzs0sntKll7tNw-157">
            <mxGeometry relative="1" x="-0.32" y="-10" as="geometry">
              <mxPoint as="offset" />
              <Array as="points">
                <mxPoint x="950" y="1510" />
                <mxPoint x="760" y="1510" />
              </Array>
            </mxGeometry>
          </mxCell>
        </object>
        <object label="CAP_X / B / CFG" tooltip="Sequencer supplies capture enables and destination tags, delayed by the SRAM read latency. These signals carry control only; the data arrives directly from SRAM Q wires. CAP_W goes to the PE array on MAC_CTRL." id="fEt4LbSzs0sntKll7tNw-163">
          <mxCell edge="1" parent="1" source="fEt4LbSzs0sntKll7tNw-127" style="rounded=0;html=1;endArrow=classic;defaultLabelBackgroundColor=page;edgeStyle=none;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.875;entryX=0;entryY=0.42857142857142855;exitPerimeter=0;entryPerimeter=0;" target="fEt4LbSzs0sntKll7tNw-157">
            <mxGeometry relative="1" x="-0.2571" y="10" as="geometry">
              <mxPoint as="offset" />
              <Array as="points" />
            </mxGeometry>
          </mxCell>
        </object>
        <mxCell id="fEt4LbSzs0sntKll7tNw-167" edge="1" parent="1" style="endArrow=classic;html=1;rounded=0;defaultLabelBackgroundColor=page;edgeStyle=none;jumpStyle=arc;jumpSize=10;exitX=0;exitY=0;entryX=0.75;entryY=1;exitPerimeter=0;entryPerimeter=0;" target="fEt4LbSzs0sntKll7tNw-118" value="bias[31:0] / LOAD_BIAS">
          <mxGeometry relative="1" x="-1" as="geometry">
            <mxPoint x="80" y="-25" as="offset" />
            <Array as="points" />
            <mxPoint x="1200" y="480" as="sourcePoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="BZO00zG9JKyp_xtQwubo-2" edge="1" parent="1" source="fEt4LbSzs0sntKll7tNw-143" style="endArrow=classic;html=1;rounded=0;defaultLabelBackgroundColor=page;exitX=0.312;exitY=0.002;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.635;entryY=0.008;entryDx=0;entryDy=0;entryPerimeter=0;" target="fEt4LbSzs0sntKll7tNw-127" value="">
          <mxGeometry height="50" relative="1" width="50" x="-0.105" as="geometry">
            <Array as="points">
              <mxPoint x="2260" y="740" />
              <mxPoint x="230" y="740" />
            </Array>
            <mxPoint x="1030" y="950" as="sourcePoint" />
            <mxPoint x="230" y="970" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <object label="FIFO_VALID / FULL" tooltip="Result-available status to sequencer. POST is blocked while full. STORE consumes one entry after SRAM write acceptance. DONE is issued only after final required write." id="BZO00zG9JKyp_xtQwubo-3">
          <mxCell parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" vertex="1">
            <mxGeometry height="30" width="130" x="510" y="750" as="geometry" />
          </mxCell>
        </object>
        <object label="RD_VALID" tooltip="Wrapper-generated timing signal to the sequencer. A memory macro may supply only Q; then the wrapper pipelines RD_EN to form RD_VALID. It does not autonomously choose addresses." id="BZO00zG9JKyp_xtQwubo-6">
          <mxCell parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" vertex="1">
            <mxGeometry height="30" width="95" x="240" y="1640" as="geometry" />
          </mxCell>
        </object>
        <object label="No fetch/copy FSM&lt;br&gt;capture control only" tooltip="Address sequencing belongs to AGU/FSM. Operand registers simply capture SRAM output under enables. This reduces structural overhead but does not remove SRAM read latency or register setup/hold requirements." id="BZO00zG9JKyp_xtQwubo-7">
          <mxCell parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" vertex="1">
            <mxGeometry height="40" width="195" x="680" y="1290" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="BZO00zG9JKyp_xtQwubo-10" edge="1" parent="1" source="BZO00zG9JKyp_xtQwubo-8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=page;" target="BZO00zG9JKyp_xtQwubo-9" value="">
