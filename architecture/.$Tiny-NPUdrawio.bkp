        <mxCell id="p3n15" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontColor=#172B4D;fontSize=15;align=left;verticalAlign=middle;spacing=10;" value="E3" vertex="1">
