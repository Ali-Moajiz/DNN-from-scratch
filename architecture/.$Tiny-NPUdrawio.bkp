        <mxCell id="p3n12" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#172B4D;fontSize=15;align=left;verticalAlign=middle;spacing=10;" value="B0_REQ" vertex="1">
