        <mxCell id="p2n6" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1F5FF;strokeColor=#175CD3;fontColor=#172B4D;fontSize=16;align=center;verticalAlign=middle;spacing=10;" value="&lt;b&gt;ADDER&lt;br&gt;acc + signextend(product)&lt;br&gt;32-bit result&lt;/b&gt;" vertex="1">
