        <mxCell id="p6n8" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontColor=#172B4D;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontSize=15;align=left;verticalAlign=middle;spacing=10;" value="All 16 stationary INT8 weights loaded together" vertex="1">
