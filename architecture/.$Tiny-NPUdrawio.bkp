          <mxGeometry relative="1" x="-1" as="geometry">
            <mxPoint x="45" y="-12" as="offset" />
            <Array as="points" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p2n14" edge="1" parent="1" source="p2n8" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#175CD3;strokeWidth=2;fontSize=14;fontColor=#175CD3;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitPerimeter=0;entryX=0.489;entryY=1;entryPerimeter=0;" target="p2n6" value="acc[31:0]: old registered sum feeds next addition">
          <mxGeometry relative="1" x="-1" as="geometry">
            <mxPoint x="-310" y="168" as="offset" />
            <Array as="points">
              <mxPoint x="1460" y="550" />
              <mxPoint x="835" y="550" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="p2n15" edge="1" parent="1" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#175CD3;strokeWidth=2;fontSize=14;fontColor=#175CD3;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitPerimeter=0;entryX=0.452;entryY=0;entryPerimeter=0;" target="p2n7" value="bias[31:0] from SRAM read data">
          <mxGeometry relative="1" x="-1" as="geometry">
            <mxPoint y="-22" as="offset" />
            <Array as="points" />
            <mxPoint x="1155" y="185" as="sourcePoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p2n16" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1F5FF;strokeColor=none;fontColor=#172B4D;fontSize=18;align=left;verticalAlign=middle;spacing=10;strokeWidth=0;" value="REGISTER UPDATE RULES (on rising clk)&lt;br&gt;reset: acc &amp;lt;= 0. Else if load_bias: acc &amp;lt;= bias. Else if mac_en: acc &amp;lt;= acc + signextend(product). Else: hold acc.&lt;br&gt;x_cap / w_cap independently load operand registers from SRAM rdata[7:0]. No accumulator update during operand capture.&lt;br&gt;The final accumulation edge updates acc; the following POST edge captures the activated / shifted / clamped result." vertex="1">
          <mxGeometry height="165" width="1510" x="40" y="635" as="geometry" />
        </mxCell>
        <mxCell id="p2n17" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=none;fontColor=#172B4D;fontSize=18;align=left;verticalAlign=middle;spacing=10;strokeWidth=0;" value="NUMERIC CONTRACT&lt;br&gt;Accumulator width is 32 bits, replacing the original diagram&amp;#x27;s ambiguous 16-bit result path. INT8 output conversion is explicitly included.&lt;br&gt;ReLU: max(0, acc), or bypass. Then arithmetic right shift (floor division by 2^shift), then clamp to [-128, 127].&lt;br&gt;This is a simple fixed-point baseline, not general framework-compatible quantization. Per-layer shift is supplied by software.&lt;br&gt;Arithmetic overflow must be prevented by the supported K / bias range; this model does not saturate the accumulator.&lt;br&gt;The result completes one neuron&amp;#x27;s dot product, not necessarily the entire matrix or layer." vertex="1">
          <mxGeometry height="220" width="1510" x="40" y="840" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
