        <mxCell id="p3n121" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontColor=#172B4D;fontSize=15;align=left;verticalAlign=middle;spacing=10;" value="SRAM[out_base+1] &amp;lt;= signextend(q1); enter DONE" vertex="1">
          <mxGeometry height="35" width="990" x="310" y="1160" as="geometry" />
        </mxCell>
        <mxCell id="p3n122" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontColor=#172B4D;fontSize=15;align=left;verticalAlign=middle;spacing=10;" value="140 / 320" vertex="1">
          <mxGeometry height="35" width="265" x="1300" y="1160" as="geometry" />
        </mxCell>
        <mxCell id="p3n123" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1F5FF;strokeColor=none;fontColor=#172B4D;fontSize=17;align=left;verticalAlign=middle;spacing=10;strokeWidth=0;" value="TIMING CONTRACT&lt;br&gt;At a REQ edge, SRAM samples addr/re and updates registered rdata after the edge. At the following CAP edge, the destination captures that stable rdata. No read is issued in CAP. Writes commit at STORE edges. POST follows the final MAC edge; it cannot capture the new final acc on that same edge." vertex="1">
          <mxGeometry height="120" width="1530" x="35" y="1220" as="geometry" />
        </mxCell>
        <mxCell id="p3n124" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=none;fontColor=#172B4D;fontSize=17;align=left;verticalAlign=middle;spacing=10;strokeWidth=0;" value="LATENCY / HANDSHAKE&lt;br&gt;For a full two-neuron pair: 4 bias edges + 7*K operand/compute edges + 1 POST edge + 2 STORE edges = 7*K+7 edges AFTER start acceptance. For K=3: 28 periods from E1 to E29 (29 listed edges including start). This schedule is intentionally unpipelined: only K of those edges perform two MAC updates. done becomes high after E29; hold DONE until ack, then return IDLE. busy=1 during execution and 0 in IDLE / DONE." vertex="1">
          <mxGeometry height="135" width="1530" x="35" y="1355" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
