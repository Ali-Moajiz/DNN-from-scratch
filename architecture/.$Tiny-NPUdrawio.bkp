        <mxCell id="fEt4LbSzs0sntKll7tNw-122" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Input B&lt;br&gt;8-bit" vertex="1">
