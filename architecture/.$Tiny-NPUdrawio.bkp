          <mxGeometry relative="1" as="geometry">
            <Array as="points" />
          </mxGeometry>
        </mxCell>
        <object label="32-bit adder" tooltip="Add sign-extended signed 16-bit product to signed 32-bit accumulator. Avoid accumulator overflow through supported K/bias bounds; no saturation inside MAC." id="fEt4LbSzs0sntKll7tNw-115">
          <mxCell parent="1" style="whiteSpace=wrap;html=1;" vertex="1">
            <mxGeometry height="110" width="190" x="650" y="290" as="geometry" />
