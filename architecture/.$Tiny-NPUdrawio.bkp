        </mxCell>
        <mxCell id="p6n24" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontColor=#172B4D;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontSize=15;align=left;verticalAlign=middle;spacing=10;" value="E9 / C4" vertex="1">
          <mxGeometry height="35" width="110" x="35" y="430" as="geometry" />
        </mxCell>
        <mxCell id="p6n25" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontColor=#172B4D;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontSize=15;align=left;verticalAlign=middle;spacing=10;" value="Inject x4. MAC14, MAC23, MAC32, MAC41 fire. Row 1 done: h1+b1" vertex="1">
          <mxGeometry height="35" width="760" x="145" y="430" as="geometry" />
        </mxCell>
        <mxCell id="p6n26" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontColor=#172B4D;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontSize=15;align=left;verticalAlign=middle;spacing=10;" value="M14 = 304,  M23 = 360,  M32 = -40,  M41 = 28" vertex="1">
          <mxGeometry height="35" width="660" x="905" y="430" as="geometry" />
        </mxCell>
        <mxCell id="p6n27" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontColor=#172B4D;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=15;align=left;verticalAlign=middle;spacing=10;" value="E10 / C5" vertex="1">
          <mxGeometry height="35" width="110" x="35" y="465" as="geometry" />
        </mxCell>
        <mxCell id="p6n28" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontColor=#172B4D;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=15;align=left;verticalAlign=middle;spacing=10;" value="MAC24, MAC33, MAC42 fire. Row 2 done: h2+b2" vertex="1">
