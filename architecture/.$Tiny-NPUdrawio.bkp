        <mxCell id="p6n1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontColor=#172B4D;fillColor=none;strokeColor=none;fontSize=30;align=left;verticalAlign=middle;spacing=10;strokeWidth=0;" value="Proposed 128-bit SRAM | pipelined setup + 4x4 array" vertex="1">
